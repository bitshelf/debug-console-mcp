{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dutabo.dev/schema/agent-config-v1.json",
  "title": "dutabo agent config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "agents"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "agents": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/agent"
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deploy",
        "targets"
      ],
      "properties": {
        "deploy": {
          "$ref": "#/$defs/deploy"
        },
        "targets": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/target"
          }
        }
      }
    },
    "deploy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dst",
        "mode"
      ],
      "properties": {
        "dst": {
          "type": "string",
          "maxLength": 256
        },
        "mode": {
          "type": "string",
          "enum": [
            "sync",
            "merge"
          ]
        },
        "post_hook": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "dst": {
                "const": ""
              }
            },
            "required": [
              "dst"
            ]
          },
          "then": {
            "properties": {
              "mode": {
                "const": "merge"
              }
            }
          }
        }
      ]
    },
    "target": {
      "oneOf": [
        {
          "$ref": "#/$defs/leaf"
        },
        {
          "$ref": "#/$defs/group"
        }
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/leaf"
          }
        }
      }
    },
    "leaf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "src"
      ],
      "properties": {
        "src": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "post_hook": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  }
}

{
  "_comment": "Claude Code plugin hook manifest. CLAUDE_PLUGIN_ROOT is injected by Claude Code when the plugin is enabled — all hook scripts live in hooks/claude/.",

  "SessionStart": [
    {
      "hooks": [
        { "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/claude/session-start.py" }
      ]
    }
  ],
  "SessionEnd": [
    {
      "hooks": [
        { "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/claude/session-stop.py" }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        { "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/claude/user-prompt-submit.py" }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        { "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/claude/pre-tool-use.py" }
      ]
    }
  ]
}